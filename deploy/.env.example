# Copia este fichero a deploy/.env EN EL SERVIDOR y rellénalo. deploy/.env nunca va a git (.gitignore).
# Genera cada secreto con: openssl rand -base64 32

DOMAIN=iulianlounge.com

# Superusuario de Postgres: solo crea la BD y el rol de la app la primera vez
POSTGRES_ADMIN_USER=lounge_admin
POSTGRES_ADMIN_PASSWORD=

# Rol con el que entra la app (no es superusuario)
DB_USERNAME=lounge_app
DB_PASSWORD=

# Clave de firma de los JWT: base64 de 32 bytes o más (ADR-08). Cambiarla cierra todas las sesiones
JWT_SECRET=

# Rama o tag del frontend que se construye
FRONTEND_REF=main
